<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.agrigest.controller.MainController"
            fx:id="mainPane"
            prefWidth="1000.0"
            prefHeight="600.0"
            stylesheets="@style.css"
            style="-fx-background-color: #F4F6F5;">

    <left>
        <VBox prefWidth="245.0"
              spacing="10.0"
              styleClass="sidebar">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                    <image>
                        <Image url="@../ma/agrigest/images/logo.png"/>
                    </image>
                </ImageView>

                <Label text="AgreGest" styleClass="app-title" />
            </HBox>
            <Button maxWidth="Infinity"
                    onAction="#afficherDashboard"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-home" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Tableau de bord</text>
            </Button>


            <Button maxWidth="Infinity"
                    onAction="#afficherExploitation"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-seedling" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Exploitation</text>
            </Button>


            <Button maxWidth="Infinity"
                    onAction="#afficherStock"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-boxes" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Stock et achats</text>
            </Button>

            <Button maxWidth="Infinity"
                    onAction="#afficherOuvriers"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-users" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Ouvriers</text>
            </Button>

            <Button maxWidth="Infinity"
                    onAction="#afficherTaches"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-tasks" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Tâches et planning</text>
            </Button>

            <Button maxWidth="Infinity"
                    onAction="#afficherDepenses"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-money-bill-wave" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Dépenses et revenus</text>
            </Button>

            <Button maxWidth="Infinity"
                    onAction="#afficherRapports"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-bar" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Rapports</text>
            </Button>

            <Button maxWidth="Infinity"
                    onAction="#afficherParametres"
                    graphicTextGap="12"
                    styleClass="menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-cog" iconSize="16" iconColor="white"/>
                </graphic>
                <text> Paramètres</text>
            </Button>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"
                   maxWidth="Infinity"
                   maxHeight="Infinity"
                   styleClass="content-area">

            <Label text="Bienvenue dans AgreGest"
                   wrapText="true"
                   style="-fx-font-size: 26px; -fx-text-fill: #24583F;"/>

        </StackPane>
    </center>

</BorderPane>
