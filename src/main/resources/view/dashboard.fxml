<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      alignment="TOP_LEFT"
      spacing="15"
      maxWidth="Infinity"
      maxHeight="Infinity"
      style="-fx-background-color: #F4F6F5; -fx-padding: 30;">

    <Label text="Tableau de bord"
           wrapText="true"
           style="-fx-font-size: 28px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #24583F;"/>

    <Label text="Bienvenue dans AgreGest"
           wrapText="true"
           style="-fx-font-size: 16px;
                  -fx-text-fill: #555555;"/>

</VBox>